# Anthropic API key. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: Upstash Redis for rate limiting the public demo
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional per-route model overrides.
# Defaults: haiku-5-5 / sonnet-5-5 / haiku-5-5
EXTRACT_MODEL=
CHECK_MODEL=
CHAT_MODEL=
